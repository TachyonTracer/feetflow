{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=feetflow;Username=prod_user;Password=REPLACE_WITH_SECURE_PASSWORD"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_SECURE_KEY_AT_LEAST_32_CHARACTERS",
