name: CD

on:
  push:
    branches: [main]

env:
  REGISTRY: ghcr.io
  SERVER_IMAGE: ghcr.io/${{ github.repository }}/server
  CLIENT_IMAGE: ghcr.io/${{ github.repository }}/client

jobs:
  build-and-push:
    name: Build & Push Docker Images
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4

      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Generate version tag
        id: version
        run: echo "tag=$(date +'%Y%m%d')-${GITHUB_SHA::7}" >> $GITHUB_OUTPUT

      - name: Build & push server image
        uses: docker/build-push-action@v6
        with:
          context: ./server
          push: true
          tags: |
            ${{ env.SERVER_IMAGE }}:${{ steps.version.outputs.tag }}
            ${{ env.SERVER_IMAGE }}:latest

      - name: Build & push client image
        uses: docker/build-push-action@v6
        with:
          context: ./client
          push: true
          tags: |
            ${{ env.CLIENT_IMAGE }}:${{ steps.version.outputs.tag }}
            ${{ env.CLIENT_IMAGE }}:latest

  deploy:
    name: Deploy to Server
    needs: build-and-push
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Generate version tag
        id: version
        run: echo "tag=$(date +'%Y%m%d')-${GITHUB_SHA::7}" >> $GITHUB_OUTPUT

      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.DEPLOY_HOST }}
          username: ${{ secrets.DEPLOY_USER }}
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          script: |
            set -e

            export SERVER_IMAGE=${{ env.SERVER_IMAGE }}:${{ steps.version.outputs.tag }}
            export CLIENT_IMAGE=${{ env.CLIENT_IMAGE }}:${{ steps.version.outputs.tag }}

            cd /opt/feetflow

            # Store current image tags for rollback
            docker compose ps --format json | jq -r '.Image' > .previous_images 2>/dev/null || true

            # Pull new images
            docker pull $SERVER_IMAGE
            docker pull $CLIENT_IMAGE

            # Update and restart
            docker compose up -d --no-deps server client

            # Health check with rollback
            echo "Waiting for containers to be healthy..."
            sleep 15

            SERVER_HEALTHY=$(docker inspect --format='{{.State.Health.Status}}' feetflow-server 2>/dev/null || echo "unhealthy")
            CLIENT_HEALTHY=$(docker inspect --format='{{.State.Health.Status}}' feetflow-client 2>/dev/null || echo "unhealthy")

            if [ "$SERVER_HEALTHY" != "healthy" ] || [ "$CLIENT_HEALTHY" != "healthy" ]; then
              echo "[FAILED] Health check failed. Rolling back..."

              # Rollback to previous images
              if [ -f .previous_images ]; then
                docker compose down
                docker compose up -d
              fi

              exit 1
            fi

            echo "[OK] Deployment successful."
