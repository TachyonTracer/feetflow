{
  "folders": [
    {
      "name": "Client",
      "path": "client"
    },
  ],
  "settings": {
    "files.exclude": {
      "node_modules/**": true,
      "dist/**": true,
      ".angular/**": true,
      "client/**": true,
      "server/**": true,
      "nupkg/**": true,
      "**/bin/**": true,
      "**/obj/**": true,
      "docker-compose.yml": true,
      "TachyonTracer.Templates.csproj": true,
      ".template.config/**": true,
      "*.code-workspace": true
    },
    "search.exclude": {
      "node_modules/**": true,
      "dist/**": true,
      "**/bin/**": true,
      "**/obj/**": true
    }
  },
  "extensions": {
    "recommendations": [
      "angular.ng-template",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint"
    ]
  }
}
