{
  "siteName": "feetflow",
  "siteVersion": "0.0.0",
  "defaultErrorTitle": "Encountered Error!",
  "defaultErrorMessage": "Something went wrong! Please try again later",
  "refreshTokenIntervalInMinutes": 5,
  "privateKey": "efr$#@)#E%*",
  "api": {
    "AuthController": {
      "login": {
        "apiPath": "/api/login"
      },
      "getAccessToken": {
        "apiPath": "/api/get_access_token"
      },
      "resetPassword": {
        "apiPath": "/api/custom/public/accounts/reset_password"
      }
    },
    "UsersController": {
      "getAll": {
        "apiPath": "/api/users"
      },
      "getById": {
        "apiPath": "/api/users"
      },
      "create": {
        "apiPath": "/api/users"
      },
      "update": {
        "apiPath": "/api/users"
      },
      "delete": {
        "apiPath": "/api/users"
      }
    }
  }
}
